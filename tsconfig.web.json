{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true, "types": [],
    "paths": { "@shared/*": ["./src/shared/*"], "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/api.d.ts"]
}
