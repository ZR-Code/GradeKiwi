coverage/
.vitest/
*.lcov

# ── Private data: never commit grades, credentials or databases ──
# Local app data (the app stores these in the OS app-data folder, but guard against copies)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
credentials.enc
*.enc
# Grade exports and imports made with the app (contain real student data)
GradeKiwi-*.json
GradeKiwi-*.csv
*-gradebook.xml
# Environment files (e.g. FCPS_USER / FCPS_PASS for the opt-in live test)
.env
.env.*
!.env.example

# ── Code-signing / notarization secrets ──────────────────────
*.p12
*.pfx
*.cer
*.crt
*.key
*.pem
*.mobileprovision
*.provisionprofile
.apple-credentials*
electron-builder.env

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS & editor clutter ──────────────────────────────────────
.DS_Store
.AppleDouble
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
