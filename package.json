{
  "name": "gradekiwi",
  "version": "1.0.0",
  "description": "A private, local-first grade tracker for FCPS StudentVUE.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --mac dir --universal",
    "make:dmg": "npm run build && electron-builder --mac dmg --universal",
    "make:icons": "electron scripts/make-assets.cjs",
    "make:win": "npm run build && electron-builder --win --config.directories.output=dist-win && node scripts/collect-windows.cjs"
  },
  "author": {
    "name": "Zaid Rasti"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "productName": "GradeKiwi",
  "private": true
}
